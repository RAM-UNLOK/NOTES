typeattribute ephemeral_app appdomain;
typeattribute ephemeral_app coredomain;
typeattribute ephemeral_app domain;

net_domain(ephemeral_app)
allow ephemeral_app init_tmpfs:file { getattr map open read };
allow ephemeral_app migt_dev:chr_file rw_file_perms;
allow ephemeral_app migt_file:dir r_dir_perms;
allow ephemeral_app migt_file:file r_file_perms;
allow ephemeral_app miui_process_service:service_manager find;
allow ephemeral_app system_app_service:service_manager find;
allow ephemeral_app tmpfs:{ dir file } { getattr map open read };

