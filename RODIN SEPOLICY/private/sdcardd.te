# --- sdcardd ---
typeattribute sdcardd coredomain;
typeattribute sdcardd domain;

allow sdcardd sdcardfs:dir mounton;
allow sdcardd self:capability chown;

# --- sdcardd_exec ---
typeattribute sdcardd_exec exec_type;
typeattribute sdcardd_exec file_type;
typeattribute sdcardd_exec system_file_type;

