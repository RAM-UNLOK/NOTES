# --- adbd ---
typeattribute adbd coredomain;
typeattribute adbd domain;
typeattribute adbd mlstrustedsubject;

hal_client_domain(adbd, hal_graphics_allocator)
net_domain(adbd)
allow adbd auto_test_file:dir search;
allow adbd auto_test_file:file { getattr open read };
allow adbd debuglog_data_file:dir r_dir_perms;
allow adbd debuglog_data_file:{ file lnk_file } r_file_perms;

