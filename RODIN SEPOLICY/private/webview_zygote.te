# --- webview_zygote ---
typeattribute webview_zygote coredomain;
typeattribute webview_zygote domain;
typeattribute webview_zygote mlstrustedsubject;

allow webview_zygote data_log_stability_file:dir search;
allow webview_zygote miui_coredump_file:dir { add_name search write };
allow webview_zygote miui_coredump_file:file { create open read write };
allow webview_zygote miui_hprof_file:dir { add_name getattr search setattr write };
allow webview_zygote miui_hprof_file:file { create getattr open read setattr write };
allow webview_zygote miui_native_file:dir search;
dontaudit webview_zygote zygote_tmpfs:file map;

