# --- hypsys_ssi_client ---
binder_call(hypsys_ssi_client, hypsys_ssi_server)
allow hypsys_ssi_client hypsys_ssi_service:service_manager find;
allow hypsys_ssi_client mqsasd_service:service_manager find;

# --- hypsys_ssi_server ---
allow hypsys_ssi_server hypsys_ssi_client:binder call;
allow hypsys_ssi_server hypsys_ssi_client:fd use;
allow hypsys_ssi_server hypsys_ssi_service:service_manager { add find };
allow hypsys_ssi_server mqsasd_service:service_manager { add find };
allow hypsys_ssi_server servicemanager:binder { call transfer };
allow hypsys_ssi_server servicemanager:fd use;

