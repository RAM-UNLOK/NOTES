allow shell miui_coredump_file:dir { add_name search write };
allow shell miui_coredump_file:file { create open read write };
allow shell miui_hprof_file:dir { add_name getattr search setattr write };
allow shell miui_hprof_file:file { create getattr open read setattr write };
allow shell miui_native_file:dir search;
allow shell perfetto_traces_data_file:dir { add_name create read setattr };
allow shell perfetto_traces_data_file:file { create_file_perms relabelfrom };
allow shell shelld:fifo_file rw_file_perms;
allow shell sysfs_rtmm:dir search;
allow shell trace_data_file:dir add_name;
allow shell trace_data_file:file { create relabelfrom relabelto setattr write };
dontaudit shell fs_sys_miui:dir r_dir_perms;
dontaudit shell mcd:process noatsecure;
type_transition shell mcd_exec:process mcd;

