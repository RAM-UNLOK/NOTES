# --- recovery ---
typeattribute recovery coredomain;
typeattribute recovery domain;

set_prop(recovery, boottime_prop)
allow recovery block_device:dir search;
allow recovery cache_file:dir create_dir_perms;
allow recovery cache_file:file create_file_perms;
allow recovery dm_device:chr_file { append getattr ioctl lock open read watch watch_reads write };
allow recovery kmsg_device:chr_file { append lock open write };
allow recovery mtd_device:chr_file rw_file_perms;
allow recovery mtd_device:dir search;
allow recovery proc_bootconfig:file r_file_perms;
allow recovery proc_cmdline:file r_file_perms;
allow recovery self:capability { fsetid sys_admin sys_rawio sys_resource };
allow recovery userdata_block_device:blk_file { append getattr ioctl lock open read watch watch_reads write };
allowxperm recovery userdata_block_device:blk_file ioctl { 0x1260 0x1272 0x301 };

# --- recovery_socket ---
typeattribute recovery_socket coredomain_socket;
typeattribute recovery_socket file_type;

