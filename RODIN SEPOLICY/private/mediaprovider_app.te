typeattribute mediaprovider_app appdomain;
typeattribute mediaprovider_app coredomain;
typeattribute mediaprovider_app domain;

allow mediaprovider_app bluetooth_data_file:file { getattr read };
allow mediaprovider_app connsyslogger:fd use;
allow mediaprovider_app init_tmpfs:file { getattr map open read };
allow mediaprovider_app lbs_dbg_ext:fd use;
allow mediaprovider_app migt_dev:chr_file rw_file_perms;
allow mediaprovider_app migt_file:dir r_dir_perms;
allow mediaprovider_app migt_file:file r_file_perms;
allow mediaprovider_app mobile_log_d:fd use;
allow mediaprovider_app mslgd:fd use;
allow mediaprovider_app netdiag:fd use;
allow mediaprovider_app tmpfs:{ dir file } { getattr map open read };

