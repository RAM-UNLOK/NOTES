# --- hal_mtk_bgs_client ---
binder_call(hal_mtk_bgs_client, hal_mtk_bgs_server)
allow hal_mtk_bgs_client mtk_hal_bgs_hwservice:hwservice_manager find;
allow hal_mtk_bgs_client mtk_hal_bgs_service:service_manager find;

# --- hal_mtk_bgs_server ---
