typeattribute healthd domain;

hal_client_domain(healthd, hal_light)
allow healthd app_data_file:file write;
allow healthd charger_exec:file { entrypoint execute getattr map read };
allow healthd device:dir { open read };
allow healthd dri_device:chr_file rw_file_perms;
allow healthd gpu_device:dir search;
allow healthd graphics_device:chr_file rw_file_perms;
allow healthd graphics_device:dir r_dir_perms;
allow healthd healthd:capability sys_admin;
allow healthd input_device:chr_file r_file_perms;
allow healthd input_device:dir r_dir_perms;
allow healthd proc_last_kmsg:file rw_file_perms;
allow healthd sysfs_battery_supply:dir r_dir_perms;
allow healthd sysfs_battery_supply:{ file lnk_file } r_file_perms;
allow healthd sysfs_usb_supply:dir r_dir_perms;
allow healthd sysfs_usb_supply:{ file lnk_file } r_file_perms;
allow healthd sysfs_vcorefs_pwrctrl:file write;

