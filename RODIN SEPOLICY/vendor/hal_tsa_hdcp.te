# --- hal_tsa_hdcp_client ---
binder_call(hal_tsa_hdcp_client, hal_tsa_hdcp_server)
allow hal_tsa_hdcp_client servicemanager:binder { call transfer };
allow hal_tsa_hdcp_client servicemanager:fd use;
allow hal_tsa_hdcp_client tsa_hal_hdcp_service:service_manager find;

# --- hal_tsa_hdcp_server ---
allow hal_tsa_hdcp_server hal_tsa_hdcp_client:binder call;
allow hal_tsa_hdcp_server hal_tsa_hdcp_client:fd use;
allow hal_tsa_hdcp_server servicemanager:binder { call transfer };
allow hal_tsa_hdcp_server servicemanager:fd use;
allow hal_tsa_hdcp_server tsa_hal_hdcp_service:service_manager { add find };

