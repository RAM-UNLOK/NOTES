# --- untrusted_app ---
typeattribute untrusted_app domain;

binder_use(untrusted_app)
hal_client_domain(untrusted_app, hal_mediaeventgatherservice)
hal_client_domain(untrusted_app, hal_miperf)
hal_client_domain(untrusted_app, hal_videoservice)
allow untrusted_app fuseblk:dir search;
allow untrusted_app fuseblk:file rw_file_perms;
allow untrusted_app hal_mediaeventgatherservice:binder call;
allow untrusted_app hal_mediaeventgatherservice_service:binder call;
allow untrusted_app hal_mediaeventgatherservice_service:fd use;
allow untrusted_app hal_mediaeventgatherservice_service:service_manager find;
allow untrusted_app mediaserver:dir search;
allow untrusted_app mtk_hal_neuralnetworks:binder call;
allow untrusted_app proc_mtktz:dir search;
allow untrusted_app proc_mtktz:file r_file_perms;
allow untrusted_app radio:unix_stream_socket connectto;
allow untrusted_app vtservice:dir search;
neverallow untrusted_app vendor_fp_info_prop:dir { create_dir_perms append audit_access execmod execute link map mounton quotaon relabelfrom relabelto unlink watch_mount watch_sb watch_with_perm };
neverallow untrusted_app vendor_fp_info_prop:file { create_file_perms audit_access entrypoint execmod execute execute_no_trans link mounton quotaon relabelfrom relabelto watch_mount watch_sb watch_with_perm };
neverallow untrusted_app vendor_fp_info_prop:property_service set;

