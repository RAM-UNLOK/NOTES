# --- kisd ---
type kisd;

typeattribute kisd domain;
typeattribute kisd mlstrustedsubject;

init_daemon_domain(kisd)
allow kisd block_device:dir search;
allow kisd dkb_block_device:blk_file rw_file_perms;
