# --- mobicore_app ---
type mobicore_app;

typeattribute mobicore_app domain;

app_domain(mobicore_app)
net_domain(mobicore_app)
allow mobicore_app appdomain_tmpfs:file { rx_file_perms write };
allow mobicore_app mobicore:unix_stream_socket connectto;
allow mobicore_app mobicore_admin_device:chr_file getattr;
allow mobicore_app mobicore_app_userfaultfd:anon_inode { ioctl read create };
allow mobicore_app mobicore_data_file:dir r_dir_perms;
allow mobicore_app mobicore_data_file:file r_file_perms;
allow mobicore_app mobicore_tui_device:chr_file r_file_perms;
allow mobicore_app mobicore_user_device:chr_file rw_file_perms;
type_transition mobicore_app mobicore_app:anon_inode "[userfaultfd]" mobicore_app_userfaultfd;
type_transition mobicore_app tmpfs:file appdomain_tmpfs;

# --- mobicore_app_userfaultfd ---
type mobicore_app_userfaultfd;

