typeattribute fastbootd domain;

allow fastbootd bootdevice_block_device:blk_file rw_file_perms;
allow fastbootd para_block_device:blk_file rw_file_perms;
allow fastbootd self:capability sys_rawio;
allow fastbootd self:process setfscreate;
allow fastbootd sysfs_boot_type:file rw_file_perms;
allowxperm fastbootd bootdevice_block_device:blk_file ioctl { 0x1277 0x127d 0xb300 };

