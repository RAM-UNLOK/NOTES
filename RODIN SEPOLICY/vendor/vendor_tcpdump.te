# --- vendor_tcpdump ---
type vendor_tcpdump;

typeattribute vendor_tcpdump domain;

init_daemon_domain(vendor_tcpdump)
allow vendor_tcpdump self:capability { setgid setuid net_raw };
allow vendor_tcpdump self:netlink_generic_socket create;
allow vendor_tcpdump self:netlink_generic_socket ioctl;
allow vendor_tcpdump self:packet_socket { rw_socket_perms create };
allow vendor_tcpdump sysfs:file { read open };
allow vendor_tcpdump sysfs_mm:dir search;
allow vendor_tcpdump sysfs_net:dir search;
allow vendor_tcpdump sysfs_net:file { read open };
allow vendor_tcpdump vendor_wifi_vendor_data_file:dir { write add_name search };
allow vendor_tcpdump vendor_wifi_vendor_data_file:file create_file_perms;
allowxperm vendor_tcpdump self:netlink_generic_socket ioctl { 0x8910 0x8946 };
allowxperm vendor_tcpdump self:packet_socket ioctl 0x8933;
allowxperm vendor_tcpdump self:packet_socket ioctl { 0x8927 0x8933 };
allowxperm vendor_tcpdump self:unix_dgram_socket ioctl 0x8946;

# --- vendor_tcpdump_exec ---
type vendor_tcpdump_exec, exec_type, file_type, vendor_file_type;

