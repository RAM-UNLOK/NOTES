# --- charger ---
typeattribute charger domain;

hal_client_domain(charger, hal_light)
allow charger app_data_file:file write;
allow charger charger:capability { sys_admin sys_boot };
allow charger charger:capability2 block_suspend;
allow charger charger_exec:file { entrypoint execute getattr map read };
allow charger device:dir { open read };
allow charger dri_device:chr_file rw_file_perms;
allow charger gpu_device:dir search;
allow charger graphics_device:chr_file rw_file_perms;
allow charger graphics_device:dir r_dir_perms;
allow charger input_device:chr_file r_file_perms;
allow charger input_device:dir r_dir_perms;
allow charger kmsg_device:chr_file read;
allow charger proc_last_kmsg:file rw_file_perms;
allow charger sysfs:dir { open read };
allow charger sysfs_battery_supply:dir r_dir_perms;
allow charger sysfs_battery_supply:{ file lnk_file } r_file_perms;
allow charger sysfs_power_supply:dir search;
allow charger sysfs_power_supply:file r_file_perms;
allow charger sysfs_ti_battery:dir search;
allow charger sysfs_ti_battery:file r_file_perms;
allow charger sysfs_usb_supply:dir r_dir_perms;
allow charger sysfs_usb_supply:{ file lnk_file } r_file_perms;
allow charger sysfs_vcorefs_pwrctrl:file write;

# --- charger_exec ---
typeattribute charger_exec exec_type;
typeattribute charger_exec file_type;
typeattribute charger_exec system_file_type;

