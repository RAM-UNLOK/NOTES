# --- hal_mtk_touchll_client ---
binder_call(hal_mtk_touchll_client, hal_mtk_touchll_server)
allow hal_mtk_touchll_client mtk_hal_touchll_hwservice:hwservice_manager find;

# --- hal_mtk_touchll_server ---
add_hwservice(hal_mtk_touchll_server, mtk_hal_touchll_hwservice)
allow hal_mtk_touchll_server hal_mtk_touchll_client:binder call;
allow hal_mtk_touchll_server hal_mtk_touchll_client:fd use;

