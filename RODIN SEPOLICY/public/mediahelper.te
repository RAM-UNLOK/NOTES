# --- mediahelper ---
type mediahelper;

typeattribute mediahelper coredomain;
typeattribute mediahelper domain;

init_daemon_domain(mediahelper)
allow mediahelper mediaserver:process transition;
allow mediahelper mediaserver:process { siginh rlimitinh };
allow mediahelper mediaserver_exec:file rx_file_perms;
dontaudit mediahelper mediaserver:process noatsecure;
type_transition mediahelper mediaserver_exec:process mediaserver;

# --- mediahelper_exec ---
type mediahelper_exec, exec_type, file_type, system_file_type;

